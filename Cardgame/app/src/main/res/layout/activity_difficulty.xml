<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Back button -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@android:drawable/ic_media_previous"
        android:background="@android:color/transparent"
        android:contentDescription="뒤로가기"
        app:tint="@color/text_muted"
        android:layout_marginTop="48dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Header -->
    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="난이도 선택"
        android:textColor="@color/text_white"
        android:textSize="28sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:layout_marginTop="52dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvHeaderSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="플레이 방식이 달라집니다"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tabs -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabModeSwitch"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:tabTextColor="@color/text_muted"
        app:tabSelectedTextColor="@color/text_white"
        app:tabIndicatorColor="@color/accent_cyan"
        app:tabIndicatorHeight="2dp"
        app:tabGravity="fill"
        app:tabMode="fixed"
        app:layout_constraintTop_toBottomOf="@id/tvHeaderSub"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.tabs.TabItem
            android:text="숫자 (1~10)" />

        <com.google.android.material.tabs.TabItem
            android:text="단계 (초·중·고)" />

    </com.google.android.material.tabs.TabLayout>

    <!-- Number Grid -->
    <GridLayout
        android:id="@+id/gridNumbers"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:columnCount="5"
        android:rowCount="2"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/tabModeSwitch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Numbers 1~10 -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_margin="5dp"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:background="@color/card_bg"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_margin="5dp"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:text="2"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:background="@color/card_bg"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_margin="5dp"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:text="3"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:background="@color/card_bg"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_margin="5dp"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:text="4"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:background="@color/card_bg"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_margin="5dp"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:text="5"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:background="@color/card_bg"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_margin="5dp"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:text="6"
            android:textColor="@color/accent_cyan"
            android:textSize="20sp"
            android:background="@color/card_bg"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_margin="5dp"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:text="7"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:background="@color/card_bg"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_margin="5dp"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:text="8"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:background="@color/card_bg"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_margin="5dp"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:text="9"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:background="@color/card_bg"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_margin="5dp"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:text="10"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:background="@color/card_bg"/>

    </GridLayout>

    <!-- Description Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardModeDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/gridNumbers"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ivModeIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/ic_dialog_info"
                    android:contentDescription="퍼즐 모드"
                    app:tint="@color/accent_cyan" />

                <TextView
                    android:id="@+id/tvModeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="퍼즐 모드"
                    android:textColor="@color/text_white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginStart="10dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvModeRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lv. 1 - 5"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:padding="6dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvModeDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI가 출제한 보안 문제를 카드로 해결하는 퍼즐 방식입니다."
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.5"
                android:layout_marginTop="10dp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Confirm Button -->
    <Button
        android:id="@+id/btnConfirm"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="선택한 난이도로 시작"
        android:textColor="@color/bg_dark"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="@color/accent_cyan"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>