<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <View
        android:id="@+id/glowTop"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:alpha="0.15"
        android:background="@android:color/transparent"
        android:layout_marginStart="-80dp"
        android:layout_marginTop="-80dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/glowBottom"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:alpha="0.12"
        android:background="@android:color/transparent"
        android:layout_marginEnd="-60dp"
        android:layout_marginBottom="-60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SECURITY CARD GAME"
        android:textColor="@color/accent_cyan"
        android:textSize="12sp"
        android:letterSpacing="0.3"
        android:textStyle="bold"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@android:color/transparent"
        android:layout_marginTop="52dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/ivShield"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@android:drawable/ic_dialog_info"
        android:contentDescription="보안 아이콘"
        app:tint="@color/accent_cyan"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvBadge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SECURE\nBATTLE"
        android:textColor="@color/text_white"
        android:textSize="48sp"
        android:textStyle="bold"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:lineSpacingMultiplier="0.9"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/ivShield"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="보안 지식을 카드로 싸워라"
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/divider"
        android:layout_width="48dp"
        android:layout_height="2dp"
        android:background="@color/accent_cyan"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/layoutButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnPlay"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="게임 시작"
            android:textColor="@color/bg_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:backgroundTint="@color/accent_cyan"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btnCardCollection"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="카드 도감"
            android:textColor="@color/accent_cyan"
            android:textSize="16sp"
            android:backgroundTint="@color/card_bg"
            android:stateListAnimator="@null"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnQuiz"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="퀴즈 연습"
            android:textColor="@color/text_muted"
            android:textSize="16sp"
            android:backgroundTint="@color/card_bg"
            android:stateListAnimator="@null"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v1.0.0  ·  BETA"
        android:textColor="@color/text_dim"
        android:textSize="12sp"
        android:letterSpacing="0.1"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>